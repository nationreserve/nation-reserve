# Application
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# PostgreSQL (local development examples)
POSTGRES_USER=roboworkpool
POSTGRES_PASSWORD=local-postgres-password-change-me
POSTGRES_DB=roboworkpool
POSTGRES_PORT=5432
DATABASE_URL=postgresql://roboworkpool:local-postgres-password-change-me@localhost:5432/roboworkpool
# Migration/admin connection. Production uses the Supabase session/direct URL;
# application and Edge runtimes continue to use pooled DATABASE_URL.
DIRECT_URL=postgresql://roboworkpool:local-postgres-password-change-me@localhost:5432/roboworkpool

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible object storage (local development examples)
MINIO_ROOT_USER=roboworkpool
MINIO_ROOT_PASSWORD=local-minio-password-change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=roboworkpool
S3_SECRET_KEY=local-minio-password-change-me
S3_BUCKET=roboworkpool-local

# Payments (safe local defaults; external execution remains disabled)
PAYMENT_PROVIDER=fake
PAYMENT_EXECUTION_ENABLED=false
PAYMENT_PROVIDER_ENVIRONMENT=test
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_CONNECT_CLIENT_ID=ca_replace_me
PAYMENT_PROVIDER_WEBHOOK_SECRET=fake-webhook-secret-change-me
PAYMENT_PROVIDER_CONNECT_WEBHOOK_SECRET=whsec_replace_with_connected_accounts_endpoint_secret
PAYMENT_METHOD_SETUP_RETURN_URL=http://localhost:5173/settings/billing
PAYOUT_ONBOARDING_RETURN_URL=http://localhost:5173/settings/payouts
PAYOUT_ONBOARDING_REFRESH_URL=http://localhost:5173/settings/payouts

# Supabase hosted PostgreSQL / Storage (backend-only service role; never use in browser)
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me-public-publishable-key
# Legacy aliases, only for integrations that have not migrated to the new key names.
SUPABASE_ANON_KEY=replace-me-public-anon-key
SUPABASE_SECRET_KEY=replace-me-backend-only-secret-key
SUPABASE_SERVICE_ROLE_KEY=replace-me-backend-only-service-role-key
# Set DATABASE_URL above to the Supabase pooler or direct Postgres URL.
# Supabase Storage exposes an S3-compatible endpoint; configure S3_* above when selected.

# Keep false in production unless the deployed canonical bundle is trusted and immutable.
SPECIFICATION_SYNC_ENABLED=false

# Authoritative server-side public queue enrollment switch
DOWNPAYMENT_ENROLLMENT_ENABLED=false
