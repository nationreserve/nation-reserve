FROM node:22.22.0-alpine AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages packages
RUN pnpm install --frozen-lockfile
COPY apps/api apps/api
RUN pnpm --filter @nation-reserve/api build
FROM node:22.22.0-alpine AS runtime
ARG COMMIT_SHA=unknown
LABEL org.opencontainers.image.revision=$COMMIT_SHA
ENV NODE_ENV=production
WORKDIR /workspace
RUN addgroup -S -g 10001 app && adduser -S -u 10001 -G app app && corepack enable
COPY --from=build --chown=app:app /workspace /workspace
USER 10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:${API_PORT:-3000}/ready || exit 1
CMD ["pnpm","--filter","@nation-reserve/api","start"]
