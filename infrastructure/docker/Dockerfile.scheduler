FROM node:22.22.0-alpine
ARG COMMIT_SHA=unknown
LABEL org.opencontainers.image.revision=$COMMIT_SHA
ENV NODE_ENV=production
WORKDIR /workspace
RUN addgroup -S -g 10001 app && adduser -S -u 10001 -G app app && corepack enable
COPY --chown=app:app . .
RUN corepack enable && pnpm install --frozen-lockfile --prod
USER 10001
STOPSIGNAL SIGTERM
CMD ["pnpm","--filter","@nation-reserve/api","reporting:scheduled"]
