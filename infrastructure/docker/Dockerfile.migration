FROM node:22.22.0-alpine
ARG COMMIT_SHA=unknown
LABEL org.opencontainers.image.revision=$COMMIT_SHA
ENV NODE_ENV=production
WORKDIR /workspace
RUN addgroup -S -g 10001 app && adduser -S -u 10001 -G app app && corepack enable
COPY --chown=app:app package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY --chown=app:app packages packages
RUN pnpm install --frozen-lockfile --prod
USER 10001
CMD ["pnpm","--filter","@nation-reserve/database","db:migrate"]
