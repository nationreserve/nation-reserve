import { createHash, randomUUID } from "node:crypto";
import type { Pool, PoolClient } from "pg";
import { PermissionEngine, WorkflowEngine, type AuthorizationContext, type WorkflowInstance } from "@nation-reserve/backend-core";

export class PostgresPlatformService {
  readonly #permissions=new PermissionEngine();readonly #workflows=new WorkflowEngine();
  constructor(private readonly pool:Pool,private readonly storage:{bucket:string;createUploadUrl(key:string,contentType:string,checksumSha256?:string):Promise<string>}){}
  async context(userId:string,organizationId?:string):Promise<AuthorizationContext>{
    const result=await this.pool.query<{role:string;organization_id:string;organization_type:string;permission_key:string|null;effect:string|null}>(`SELECT m.role,m.organization_id,o.organization_type,g.permission_key,g.effect FROM organization_memberships m JOIN organizations o ON o.id=m.organization_id LEFT JOIN role_permission_grants g ON g.organization_type=o.organization_type AND g.role=m.role WHERE m.user_id=$1 AND m.status='active' ${organizationId?"AND m.organization_id=$2":""}`,[userId,...(organizationId?[organizationId]:[])]);
    if(organizationId&&!result.rowCount)throw Object.assign(new Error("Organization membership required"),{code:"FORBIDDEN",statusCode:403});
    const permissions=result.rows.filter(r=>r.effect==="allow"&&r.permission_key).map(r=>r.permission_key!);const denied=new Set(result.rows.filter(r=>r.effect==="deny").map(r=>r.permission_key));
    return{userId,...(organizationId?{organizationId}:{}),roles:[...new Set(result.rows.map(r=>r.role))],permissions:[...new Set(permissions.filter(p=>!denied.has(p)))],platformOverride:result.rows.some(r=>r.organization_type==="platform"&&["super_admin","platform_admin","admin"].includes(r.role))};
  }
  async search(userId:string,input:{organizationId:string;q:string;types?:string[]|undefined;limit:number;cursor?:string|undefined;sort:"relevance"|"updated"}){const context=await this.context(userId,input.organizationId);this.#permissions.assert(context,{permission:"search.read",allowPlatformOverride:true});const values:unknown[]=[input.organizationId,input.q];const clauses=["organization_id=$1","searchable @@ websearch_to_tsquery('simple',$2)"];if(input.types?.length){values.push(input.types);clauses.push(`document_type=ANY($${values.length})`);}if(input.cursor){values.push(new Date(input.cursor));clauses.push(`updated_at<$${values.length}`);}values.push(input.limit+1);const order=input.sort==="relevance"?"ts_rank(searchable,websearch_to_tsquery('simple',$2)) DESC,updated_at DESC":"updated_at DESC";const result=await this.pool.query<{document_type:string;document_id:string;title:string;summary:string|null;metadata:Record<string,unknown>;updated_at:Date}>(`SELECT document_type,document_id,title,summary,metadata,updated_at FROM global_search_documents WHERE ${clauses.join(" AND ")} ORDER BY ${order},document_id LIMIT $${values.length}`,values);const rows=result.rows.slice(0,input.limit);return{items:rows.map(r=>({type:r.document_type,id:r.document_id,title:r.title,summary:r.summary,metadata:r.metadata,updatedAt:r.updated_at.toISOString()})),page:{limit:input.limit,hasMore:result.rows.length>input.limit,nextCursor:result.rows.length>input.limit?rows.at(-1)?.updated_at.toISOString():undefined}};}
  async notifications(userId:string,input:{status?:string|undefined;limit:number;cursor?:string|undefined}){const values:unknown[]=[userId];const clauses=["user_id=$1"];if(input.status){values.push(input.status);clauses.push(`status=$${values.length}`);}if(input.cursor){values.push(new Date(input.cursor));clauses.push(`created_at<$${values.length}`);}values.push(input.limit+1);const result=await this.pool.query<{id:string;channel:string;title:string;body:string;href:string|null;status:string;created_at:Date;read_at:Date|null}>(`SELECT id,channel,title,body,href,status,created_at,read_at FROM notifications WHERE ${clauses.join(" AND ")} ORDER BY created_at DESC,id DESC LIMIT $${values.length}`,values);const rows=result.rows.slice(0,input.limit);return{items:rows.map(r=>({id:r.id,channel:r.channel,title:r.title,body:r.body,href:r.href,status:r.status,createdAt:r.created_at.toISOString(),readAt:r.read_at?.toISOString()})),page:{limit:input.limit,hasMore:result.rows.length>input.limit,nextCursor:result.rows.length>input.limit?rows.at(-1)?.created_at.toISOString():undefined}};}
  async readNotification(userId:string,id:string){const result=await this.pool.query(`UPDATE notifications SET status='read',read_at=coalesce(read_at,now()) WHERE id=$1 AND user_id=$2 RETURNING id,status,read_at`,[id,userId]);if(!result.rowCount)throw Object.assign(new Error("Notification not found"),{code:"NOT_FOUND",statusCode:404});return result.rows[0];}
  async conversations(userId:string,input:{limit:number;cursor?:string|undefined}){const result=await this.pool.query(`SELECT c.id,c.conversation_type,c.subject,c.updated_at,(SELECT body FROM messages WHERE conversation_id=c.id AND deleted_at IS NULL ORDER BY created_at DESC LIMIT 1) last_message FROM conversations c JOIN conversation_participants p ON p.conversation_id=c.id WHERE p.user_id=$1 AND p.left_at IS NULL AND ($2::timestamptz IS NULL OR c.updated_at<$2) ORDER BY c.updated_at DESC LIMIT $3`,[userId,input.cursor??null,input.limit]);return{items:result.rows,page:{limit:input.limit,hasMore:false}};}
  async messages(userId:string,conversationId:string,input:{limit:number;cursor?:string|undefined}){await this.assertParticipant(userId,conversationId);const result=await this.pool.query(`SELECT m.id,m.sender_user_id "senderUserId",u.display_name "senderName",m.body,m.mentions,m.attachments,m.created_at "createdAt" FROM messages m LEFT JOIN users u ON u.id=m.sender_user_id WHERE m.conversation_id=$1 AND m.deleted_at IS NULL AND ($2::timestamptz IS NULL OR m.created_at<$2) ORDER BY m.created_at DESC,m.id DESC LIMIT $3`,[conversationId,input.cursor??null,input.limit]);return{items:result.rows,page:{limit:input.limit,hasMore:false}};}
  async sendMessage(userId:string,conversationId:string,input:{body:string;mentions:string[];attachments:unknown[]},idempotencyKey:string){await this.assertParticipant(userId,conversationId);return this.transaction(async client=>{const prior=await this.beginIdempotency(client,`message:${conversationId}`,idempotencyKey,input);if(prior)return prior;const id=randomUUID();const result=await client.query(`INSERT INTO messages(id,conversation_id,sender_user_id,body,mentions,attachments) VALUES($1,$2,$3,$4,$5,$6) RETURNING id,created_at "createdAt"`,[id,conversationId,userId,input.body,input.mentions,JSON.stringify(input.attachments)]);await client.query("UPDATE conversations SET updated_at=now() WHERE id=$1",[conversationId]);await this.emit(client,{type:"message.sent",aggregateType:"conversation",aggregateId:conversationId,actorUserId:userId,payload:{conversationId,messageId:id},timeline:{category:"messaging",summary:"Message sent",relatedObjects:[{type:"conversation",id:conversationId,label:"Conversation"}]}});const response={id,...result.rows[0]};await this.completeIdempotency(client,`message:${conversationId}`,idempotencyKey,response);return response;});}
  async createUpload(userId:string,input:{organizationId:string;filename:string;contentType:string;sizeBytes:number;checksumSha256?:string|undefined},idempotencyKey:string){const context=await this.context(userId,input.organizationId);this.#permissions.assert(context,{permission:"storage.upload",allowPlatformOverride:true});return this.transaction(async client=>{const prior=await this.beginIdempotency(client,`upload:${input.organizationId}`,idempotencyKey,input);if(prior)return prior;const id=randomUUID(),key=`${input.organizationId}/${id}/${input.filename.replace(/[^a-zA-Z0-9._-]/g,"_")}`;await client.query(`INSERT INTO stored_objects(id,organization_id,owner_user_id,bucket,object_key,filename,content_type,size_bytes,checksum_sha256) VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9)`,[id,input.organizationId,userId,this.storage.bucket,key,input.filename,input.contentType,input.sizeBytes,input.checksumSha256??null]);await client.query(`INSERT INTO background_jobs(job_type,payload,organization_id,idempotency_key) VALUES('file.malware_scan',$1,$2,$3),('file.thumbnail',$1,$2,$4) ON CONFLICT DO NOTHING`,[JSON.stringify({objectId:id,key}),input.organizationId,`scan:${id}`,`thumbnail:${id}`]);const url=await this.storage.createUploadUrl(key,input.contentType,input.checksumSha256);const response={id,key,status:"pending_upload",upload:{method:"PUT",url,expiresInSeconds:900,headers:{"content-type":input.contentType}}};await this.completeIdempotency(client,`upload:${input.organizationId}`,idempotencyKey,response);return response;});}
  async transition(userId:string,input:{organizationId:string;workflowId:string;action:string;expectedVersion:number},idempotencyKey:string){const context=await this.context(userId,input.organizationId);this.#permissions.assert(context,{permission:"workflow.transition",allowPlatformOverride:true});return this.transaction(async client=>{const prior=await this.beginIdempotency(client,`workflow:${input.workflowId}`,idempotencyKey,input);if(prior)return prior;const locked=await client.query<{id:string;workflow_type:string;aggregate_type:string;aggregate_id:string;state:string;version:number;organization_ids:string[]}>("SELECT * FROM workflow_instances WHERE id=$1 AND $2=ANY(organization_ids) FOR UPDATE",[input.workflowId,input.organizationId]);const row=locked.rows[0];if(!row)throw Object.assign(new Error("Workflow not found"),{code:"NOT_FOUND",statusCode:404});if(row.version!==input.expectedVersion)throw Object.assign(new Error("Workflow version conflict"),{code:"VERSION_CONFLICT",statusCode:409});const instance:WorkflowInstance={id:row.id,type:row.workflow_type,aggregateType:row.aggregate_type,aggregateId:row.aggregate_id,state:row.state,version:row.version,organizationIds:row.organization_ids};const result=this.#workflows.transition(instance,input.action,userId);const eventId=await this.emit(client,{type:result.event.type,aggregateType:result.event.aggregateType,aggregateId:result.event.aggregateId,actorUserId:userId,payload:result.event.payload,timeline:result.event.metadata.timeline??{},organizationIds:result.event.metadata.organizationIds});await client.query("UPDATE workflow_instances SET state=$2,version=$3 WHERE id=$1",[row.id,result.instance.state,result.instance.version]);await client.query("INSERT INTO workflow_transition_history(workflow_id,from_state,action,to_state,actor_user_id,event_id) VALUES($1,$2,$3,$4,$5,$6)",[row.id,row.state,input.action,result.instance.state,userId,eventId]);await this.completeIdempotency(client,`workflow:${input.workflowId}`,idempotencyKey,result.instance);return result.instance;});}
  private async assertParticipant(userId:string,conversationId:string){const result=await this.pool.query("SELECT 1 FROM conversation_participants WHERE conversation_id=$1 AND user_id=$2 AND left_at IS NULL",[conversationId,userId]);if(!result.rowCount)throw Object.assign(new Error("Conversation access denied"),{code:"FORBIDDEN",statusCode:403});}
  private async beginIdempotency(client:PoolClient,scope:string,key:string,body:unknown){const hash=createHash("sha256").update(JSON.stringify(body)).digest("hex");const inserted=await client.query(`INSERT INTO idempotency_records(scope,idempotency_key,request_hash,expires_at) VALUES($1,$2,$3,now()+interval '24 hours') ON CONFLICT DO NOTHING RETURNING id`,[scope,key,hash]);if(inserted.rowCount)return undefined;const existing=await client.query<{request_hash:string;status:string;response_body:unknown}>("SELECT request_hash,status,response_body FROM idempotency_records WHERE scope=$1 AND idempotency_key=$2 FOR UPDATE",[scope,key]);if(existing.rows[0]?.request_hash!==hash)throw Object.assign(new Error("Idempotency key reused with a different request"),{code:"IDEMPOTENCY_CONFLICT",statusCode:409});if(existing.rows[0]?.status==="completed")return existing.rows[0].response_body;throw Object.assign(new Error("Request with this idempotency key is processing"),{code:"IDEMPOTENCY_IN_PROGRESS",statusCode:409});}
  private completeIdempotency(client:PoolClient,scope:string,key:string,response:unknown){return client.query("UPDATE idempotency_records SET status='completed',response_status=200,response_body=$3 WHERE scope=$1 AND idempotency_key=$2",[scope,key,JSON.stringify(response)]);}
  private async emit(client:PoolClient,input:{type:string;aggregateType:string;aggregateId:string;actorUserId:string;payload:Record<string,unknown>;timeline:Record<string,unknown>;organizationIds?:string[]}){const id=randomUUID();await client.query(`INSERT INTO outbox_events(id,event_type,aggregate_type,aggregate_id,payload,metadata,occurred_at) VALUES($1,$2,$3,$4,$5,$6,now())`,[id,input.type,input.aggregateType,input.aggregateId,JSON.stringify(input.payload),JSON.stringify({schemaVersion:1,actorUserId:input.actorUserId,timeline:{...input.timeline,organizationIds:input.organizationIds??[]}})]);return id;}
  private async transaction<T>(operation:(client:PoolClient)=>Promise<T>){const client=await this.pool.connect();try{await client.query("BEGIN");const value=await operation(client);await client.query("COMMIT");return value;}catch(error){await client.query("ROLLBACK");throw error;}finally{client.release();}}
}




