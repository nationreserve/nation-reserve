{
    "name":  "@nation-reserve/api",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch --env-file=../../.env src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "tsx dist/server.js",
                    "lint":  "eslint src",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "heartbeat:offline":  "tsx --env-file=../../.env src/offline-worker.ts",
                    "financial:finalize-operating-time":  "tsx --env-file=../../.env src/financial-finalization-worker.ts",
                    "financial:reconcile":  "tsx --env-file=../../.env src/financial-command.ts reconcile",
                    "billing:generate-invoices":  "tsx --env-file=../../.env src/financial-command.ts generate-invoices",
                    "payroll:generate-statements":  "tsx --env-file=../../.env src/financial-command.ts generate-statements",
                    "settlement:prepare":  "tsx --env-file=../../.env src/financial-command.ts prepare",
                    "financial:simulate":  "tsx --env-file=../../.env src/financial-command.ts simulate",
                    "clean":  "node -e \"require(\u0027fs\u0027).rmSync(\u0027dist\u0027,{recursive:true,force:true})\"",
                    "payments:collect-invoices":  "tsx --env-file=../../.env src/payment-command.ts collect-invoices",
                    "payments:retry":  "tsx --env-file=../../.env src/payment-command.ts retry",
                    "payments:reconcile":  "tsx --env-file=../../.env src/payment-command.ts reconcile",
                    "payments:simulate-company-payment":  "tsx --env-file=../../.env src/payment-command.ts simulate-company-payment",
                    "payments:simulate-owner-payout":  "tsx --env-file=../../.env src/payment-command.ts simulate-owner-payout",
                    "payments:simulate-webhook":  "tsx --env-file=../../.env src/payment-command.ts simulate-webhook",
                    "payments:simulate-refund":  "tsx --env-file=../../.env src/payment-command.ts simulate-refund",
                    "operations:evaluate-alerts":  "tsx --env-file=../../.env src/operations-command.ts evaluate-alerts",
                    "reporting:refresh":  "tsx --env-file=../../.env src/reporting-worker.ts",
                    "reporting:scheduled":  "tsx --env-file=../../.env src/scheduled-report-worker.ts",
                    "cache:invalidate":  "tsx --env-file=../../.env src/cache-invalidation-worker.ts",
                    "allocations:expire":  "tsx --env-file=../../.env src/allocation-expiration-command.ts",
                    "allocations:reminders":  "tsx --env-file=../../.env src/allocation-reminder-command.ts"
                },
    "dependencies":  {
                         "@aws-sdk/client-s3":  "latest",
                         "@aws-sdk/s3-request-presigner":  "latest",
                         "@fastify/cors":  "latest",
                         "@nation-reserve/auth":  "workspace:*",
                         "@nation-reserve/backend-core":  "workspace:*",
                         "@nation-reserve/config":  "workspace:*",
                         "@nation-reserve/contract-operations":  "workspace:*",
                         "@nation-reserve/database":  "workspace:*",
                         "@nation-reserve/domain":  "workspace:*",
                         "@nation-reserve/financial-domain":  "workspace:*",
                         "@nation-reserve/heartbeat-domain":  "workspace:*",
                         "@nation-reserve/logger":  "workspace:*",
                         "@nation-reserve/operations":  "workspace:*",
                         "@nation-reserve/payments":  "workspace:*",
                         "@nation-reserve/robot-integration":  "workspace:*",
                         "@nation-reserve/types":  "workspace:*",
                         "exceljs":  "^4.4.0",
                         "fastify":  "latest",
                         "ioredis":  "latest",
                         "pdfkit":  "^0.19.1",
                         "pg":  "latest",
                         "zod":  "latest",
                         "@nation-reserve/analytics":  "workspace:*",
                         "@nation-reserve/forecasting":  "workspace:*",
                         "@nation-reserve/reporting":  "workspace:*",
                         "@nation-reserve/reporting-exports":  "workspace:*",
                         "@nation-reserve/warehouse":  "workspace:*",
                         "@nation-reserve/specification":  "workspace:*"
                     },
    "devDependencies":  {
                            "@types/pdfkit":  "^0.17.6",
                            "@types/pg":  "latest",
                            "tsx":  "latest",
                            "vitest":  "latest"
                        }
}
