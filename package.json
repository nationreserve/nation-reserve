{
  "name": "nation-reserve",
  "version": "0.1.0",
  "private": true,
  "description": "Nation Reserve RoboWorkPool platform monorepo",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "corepack pnpm -r --parallel run dev",
    "build": "corepack pnpm -r run build",
    "test": "corepack pnpm -r run test",
    "test:watch": "corepack pnpm -r --parallel run test:watch",
    "lint": "corepack pnpm -r run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "corepack pnpm -r run typecheck",
    "clean": "turbo run clean && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "pnpm --filter @nation-reserve/database db:migrate",
    "db:seed": "pnpm --filter @nation-reserve/database db:seed",
    "db:reset": "pnpm --filter @nation-reserve/database db:reset",
    "test:integration": "pnpm --filter @nation-reserve/database test:integration",
    "heartbeat:simulate": "pnpm --filter @nation-reserve/heartbeat-domain simulate",
    "heartbeat:offline": "pnpm --filter @nation-reserve/api heartbeat:offline",
    "financial:finalize-operating-time": "pnpm --filter @nation-reserve/api financial:finalize-operating-time",
    "financial:reconcile": "pnpm --filter @nation-reserve/api financial:reconcile",
    "billing:generate-invoices": "pnpm --filter @nation-reserve/api billing:generate-invoices",
    "payroll:generate-statements": "pnpm --filter @nation-reserve/api payroll:generate-statements",
    "settlement:prepare": "pnpm --filter @nation-reserve/api settlement:prepare",
    "financial:simulate": "pnpm --filter @nation-reserve/api financial:simulate",
    "payments:collect-invoices": "pnpm --filter @nation-reserve/api payments:collect-invoices",
    "payments:retry": "pnpm --filter @nation-reserve/api payments:retry",
    "payments:reconcile": "pnpm --filter @nation-reserve/api payments:reconcile",
    "payments:simulate-company-payment": "pnpm --filter @nation-reserve/api payments:simulate-company-payment",
    "payments:simulate-owner-payout": "pnpm --filter @nation-reserve/api payments:simulate-owner-payout",
    "payments:simulate-webhook": "pnpm --filter @nation-reserve/api payments:simulate-webhook",
    "payments:simulate-refund": "pnpm --filter @nation-reserve/api payments:simulate-refund",
    "operations:evaluate-alerts": "pnpm --filter @nation-reserve/api operations:evaluate-alerts",
    "reporting:refresh": "pnpm --filter @nation-reserve/api reporting:refresh",
    "reporting:scheduled": "pnpm --filter @nation-reserve/api reporting:scheduled",
    "specification:validate": "corepack pnpm --filter @nation-reserve/specification validate",
    "specification:coverage": "corepack pnpm --filter @nation-reserve/specification coverage",
    "specification:coverage:strict": "corepack pnpm --filter @nation-reserve/specification coverage:strict",
    "specification:report": "corepack pnpm --filter @nation-reserve/specification report",
    "specification:sync": "corepack pnpm --filter @nation-reserve/specification sync",
    "web:dev": "corepack pnpm --filter @nation-reserve/web dev",
    "web:build": "corepack pnpm --filter @nation-reserve/web build",
    "web:test": "corepack pnpm --filter @nation-reserve/web test",
    "web:test:a11y": "corepack pnpm --filter @nation-reserve/web test:a11y",
    "web:test:e2e": "corepack pnpm --filter @nation-reserve/web test:e2e",
    "web:test:visual": "corepack pnpm --filter @nation-reserve/web test:visual",
    "storybook": "corepack pnpm --filter @nation-reserve/web dev -- --open /development/components",
    "storybook:build": "corepack pnpm --filter @nation-reserve/web build",
    "ci:validate": "pnpm specification:validate && pnpm format:check && pnpm lint && pnpm typecheck",
    "ci:test": "pnpm test && pnpm test:integration && pnpm test:e2e:critical",
    "ci:security": "pnpm audit --audit-level high && pnpm test:security",
    "ci:build": "pnpm build",
    "infrastructure:validate": "terraform -chdir=infrastructure/terraform/environments/test init -backend=false && terraform -chdir=infrastructure/terraform/environments/test validate",
    "infrastructure:plan": "terraform -chdir=infrastructure/terraform/environments/test plan",
    "infrastructure:apply": "node -e \"throw new Error('Use the protected infrastructure workflow for apply')\"",
    "migrate:plan": "node scripts/migrations/plan.mjs",
    "migrate:deploy": "pnpm db:migrate",
    "migrate:status": "pnpm migrate:plan",
    "test:e2e": "pnpm web:test:e2e",
    "test:e2e:critical": "pnpm web:test:e2e",
    "test:load": "k6 run scripts/load/prompt-020.k6.js",
    "test:resilience": "node scripts/resilience/queue-replay.mjs",
    "test:accessibility": "pnpm web:test:a11y",
    "test:security": "node scripts/security/verify-source.mjs",
    "backup:test": "pwsh -File scripts/backup/verify-postgres.ps1",
    "disaster-recovery:drill": "node scripts/resilience/queue-replay.mjs",
    "release:create": "node scripts/release/create-manifest.mjs",
    "release:validate": "pnpm ci:validate && pnpm ci:test && pnpm ci:security && pnpm ci:build",
    "release:staging": "node scripts/release/validate-environment.mjs",
    "release:production": "node scripts/release/validate-environment.mjs",
    "release:rollback": "node -e \"throw new Error('Use the protected release workflow with a previous approved digest')\"",
    "launch:check": "node scripts/release/validate-environment.mjs",
    "launch:smoke": "node scripts/release/smoke.mjs",
    "launch:verify": "pnpm launch:smoke && pnpm specification:validate",
    "acceptance:mvp": "node scripts/acceptance/mvp.mjs",
    "acceptance:test": "node --test scripts/acceptance/mvp.test.mjs",
    "quality:encoding": "node scripts/quality/mojibake.mjs",
    "allocations:expire": "pnpm --filter @nation-reserve/api allocations:expire",
    "allocations:reminders": "pnpm --filter @nation-reserve/api allocations:reminders"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "^22.20.1",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "latest",
    "supabase": "^2.116.0",
    "turbo": "latest",
    "typescript": "6.0.2",
    "typescript-eslint": "latest"
  },
  "type": "module"
}
